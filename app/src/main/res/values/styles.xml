<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="MyraLabel">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">20dp</item>
        <item name="android:layout_marginBottom">6dp</item>
        <item name="android:fontFamily">monospace</item>
        <item name="android:textColor">@color/myra_hint</item>
        <item name="android:textSize">11sp</item>
        <item name="android:letterSpacing">0.1</item>
    </style>
    <style name="MyraInput">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">52dp</item>
        <item name="android:background">@drawable/bg_input_field</item>
        <item name="android:paddingStart">14dp</item>
        <item name="android:paddingEnd">14dp</item>
        <item name="android:textColor">@color/myra_text</item>
        <item name="android:textColorHint">#555555</item>
        <item name="android:textSize">14sp</item>
        <item name="android:maxLines">1</item>
    </style>
    <style name="MyraRadio">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">44dp</item>
        <item name="android:textColor">@color/myra_text</item>
        <item name="android:buttonTint">@color/myra_red</item>
        <item name="android:textSize">14sp</item>
    </style>
</resources>

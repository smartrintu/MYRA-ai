<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="oval">
            <solid android:color="#FF0A0506" />
            <stroke android:width="2dp" android:color="#FFFF2A2A" />
        </shape>
    </item>
    <item android:top="6dp" android:bottom="6dp" android:left="6dp" android:right="6dp">
        <shape android:shape="oval">
            <gradient android:type="radial" android:gradientRadius="40dp" android:centerX="0.4" android:centerY="0.35"
                android:startColor="#FF8A75" android:endColor="#7A1020" />
        </shape>
    </item>
</layer-list>

<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#050505" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <gradient android:type="radial" android:centerX="0.0" android:centerY="0.0"
                android:gradientRadius="320dp" android:startColor="#33FF1744" android:endColor="#00FF1744" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <gradient android:type="radial" android:centerX="1.0" android:centerY="1.0"
                android:gradientRadius="320dp" android:startColor="#33D500F9" android:endColor="#00D500F9" />
        </shape>
    </item>
</layer-list>

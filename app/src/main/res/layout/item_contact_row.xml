<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="12dp"
    android:background="@drawable/bg_prime_badge"
    android:orientation="vertical"
    android:padding="14dp">

    <TextView
        android:id="@+id/rowLabel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:fontFamily="casual"
        android:textColor="#FFC2D4"
        android:textSize="14sp" />

    <TextView
        android:id="@+id/rowValue"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:textColor="#FFF0F6"
        android:textIsSelectable="true"
        android:textSize="17sp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:orientation="horizontal">

        <Button
            android:id="@+id/rowAction"
            android:layout_width="0dp"
            android:layout_height="42dp"
            android:layout_marginEnd="6dp"
            android:layout_weight="1"
            android:background="@drawable/bg_save_button"
            android:backgroundTint="@null"
            android:textColor="#FFFFFF" />

        <Button
            android:id="@+id/rowCopy"
            android:layout_width="0dp"
            android:layout_height="42dp"
            android:layout_marginStart="6dp"
            android:layout_weight="1"
            android:background="@drawable/bg_prime_badge"
            android:backgroundTint="@null"
            android:text="COPY"
            android:textColor="#FF8FB8" />
    </LinearLayout>
</LinearLayout>

<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#1A0B2E"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:fontFamily="sans-serif-black"
            android:letterSpacing="0.3"
            android:text="MYRA"
            android:textColor="#FF4D8D"
            android:textSize="32sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Activation Key"
            android:textColor="#FFF0F6"
            android:textSize="18sp" />

        <TextView style="@style/MyraLabel" android:text="DEVICE ID (key ke liye bhejo)" />
        <TextView
            android:id="@+id/deviceIdText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_input_field"
            android:fontFamily="monospace"
            android:padding="14dp"
            android:textColor="#FF4D8D"
            android:textIsSelectable="true"
            android:textSize="18sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="horizontal">

            <Button
                android:id="@+id/copyIdBtn"
                android:layout_width="0dp"
                android:layout_height="46dp"
                android:layout_marginEnd="6dp"
                android:layout_weight="1"
                android:background="@drawable/bg_prime_badge"
                android:backgroundTint="@null"
                android:text="COPY"
                android:textColor="#FF4D8D" />

            <Button
                android:id="@+id/shareIdBtn"
                android:layout_width="0dp"
                android:layout_height="46dp"
                android:layout_marginStart="6dp"
                android:layout_weight="1"
                android:background="@drawable/bg_prime_badge"
                android:backgroundTint="@null"
                android:text="SHARE"
                android:textColor="#FF4D8D" />
        </LinearLayout>

        <TextView
            android:id="@+id/contactText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:textColor="#C9A7E8"
            android:textSize="12sp" />

        <Button
            android:id="@+id/contactBtn"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:layout_marginTop="10dp"
            android:background="@drawable/bg_prime_badge"
            android:backgroundTint="@null"
            android:text="📞 CONTACT KARO"
            android:textColor="#FF8FB8" />

        <TextView style="@style/MyraLabel" android:text="ACTIVATION KEY" />
        <EditText
            android:id="@+id/keyInput"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_input_field"
            android:gravity="top"
            android:hint="Key yahan paste karo"
            android:inputType="textMultiLine|textNoSuggestions"
            android:minHeight="120dp"
            android:padding="14dp"
            android:textColor="#FFF0F6"
            android:textColorHint="#8E6BB3"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/errorText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:textColor="#FF6B6B"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/infoText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:textColor="#00E676"
            android:textSize="13sp" />

        <Button
            android:id="@+id/activateBtn"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="20dp"
            android:background="@drawable/bg_save_button"
            android:backgroundTint="@null"
            android:text="ACTIVATE"
            android:textColor="#FFFFFF" />
    </LinearLayout>
</ScrollView>
